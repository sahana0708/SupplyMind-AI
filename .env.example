# Copy this file to .env and fill in real values.
# Never commit .env - it is listed in .gitignore.
# All values below are PLACEHOLDERS, not real credentials.

# Application
APP_NAME=SupplyMind AI
APP_ENV=development
APP_VERSION=0.1.0
APP_DESCRIPTION=AI-powered enterprise operations and supply chain recovery platform
DEBUG=true

# PostgreSQL (not used yet - later stage)
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/supplymind

# Claude API (not used yet - later stage)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
